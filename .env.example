# ==============================================================================
# VARIABLES DE ENTORNO PÚBLICAS DEL FRONTEND (Vite / Vercel)
# ==============================================================================
# NOTA DE SEGURIDAD:
# Las variables con prefijo VITE_ se compilan directamente en el bundle JavaScript
# público del navegador. NUNCA coloques aquí claves de servicio 'service_role' de
# Supabase ni tokens privados de backend.
# ==============================================================================

# Supabase Credentials (Database and Storage)
# Utiliza EXCLUSIVAMENTE la clave 'anon' pública. La seguridad de los datos
# reside en las políticas de seguridad a nivel de fila (RLS) en PostgreSQL.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# EmailJS Configuration for Order Receipts and Admin Notifications
# Utiliza la clave pública de EmailJS (Public Key).
VITE_EMAILJS_SERVICE_ID="service_default"
VITE_EMAILJS_PUBLIC_KEY="your_emailjs_public_key"
VITE_EMAILJS_TEMPLATE_ID_CUSTOMER="template_customer"
VITE_EMAILJS_TEMPLATE_ID_ADMIN="template_admin"
VITE_ADMIN_EMAIL="admin@myimportadora.com"

# Contraseña de acceso al Panel de Administración (/k97)
# Validada criptográficamente con tokens y firmas de sesión para prevenir bypasses.
VITE_ADMIN_PASSWORD="yugar"

# ==============================================================================
# VARIABLES DE ENTORNO DE PLATAFORMA / SISTEMA
# ==============================================================================
# GEMINI_API_KEY: Inyectada automáticamente en AI Studio.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL base donde se hospeda la aplicación.
APP_URL="MY_APP_URL"

